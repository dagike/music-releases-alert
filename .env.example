# Copy this file to .env and fill in the webhook URL. Never commit .env.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN

# Times of day to check, in server time.
SCHEDULE=00:15,06:00,12:00,18:00

# Minimum gap between Deezer requests, in milliseconds.
REQUEST_DELAY_MS=200

# Set to true to also run one check when the container starts.
RUN_ON_START=false

LOG_LEVEL=INFO
